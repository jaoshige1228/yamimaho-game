APP_NAME=Yamimaho
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=yamimaho
DB_USERNAME=yamimaho
DB_PASSWORD=secret

BROADCAST_CONNECTION=null
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database

# セーブデータをブラウザごとに分ける（既定 true）。false にすると全ブラウザが共有のデモユーザーを使う
GAME_PER_BROWSER_SAVES=true
# 1 時間に新しく作れるゲスト（新しいブラウザのセーブ）の数の全体の上限。0 で無制限
GAME_GUEST_CREATE_PER_HOUR=300
